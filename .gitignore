# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local environment values and build-time secrets.
.env
.env.*
!.env.example
dart_defines/*
!dart_defines/*.example.json
*.dart_define.json
*.dart_defines.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Real release signing credentials/keystore -- generated locally per
# machine, never something to share or commit. Losing these means a
# future release build can't be signed to match what's already
# published under this app's identity.
android/key.properties
android/keystore/
*.jks
*.keystore

# Supabase CLI local cache/state.
supabase/.temp/
